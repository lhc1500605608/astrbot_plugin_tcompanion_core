{
  "emotion": {
    "type": "object",
    "description": "情绪事件账本",
    "hint": "记录感谢、误解等情绪事件并据此调整好感度；阈值与词表可在此调整。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用情绪事件账本",
        "hint": "关闭后不再记录情绪事件，好感度也不会因对话变化。",
        "default": true
      },
      "reply_window_hours": {
        "type": "int",
        "description": "主动消息回复窗口（小时）",
        "hint": "主动消息发出后，该时间内收到回复则好感度 +0.03。",
        "default": 6
      },
      "ignore_window_hours": {
        "type": "int",
        "description": "主动消息忽略窗口（小时）",
        "hint": "主动消息发出后，该时间内没有收到回复则好感度 -0.02。",
        "default": 6
      },
      "daily_positive_cap": {
        "type": "float",
        "description": "每日好感正向上限",
        "hint": "每天因正向情绪事件最多增加的好感度。",
        "default": 0.1
      },
      "daily_negative_cap": {
        "type": "float",
        "description": "每日好感负向上限",
        "hint": "每天因负向情绪事件最多扣减的好感度；好感度最低为 0。",
        "default": 0.06
      },
      "llm_judge_enabled": {
        "type": "bool",
        "description": "启用 LLM 情绪判定",
        "hint": "当前版本仅按词表判定，此开关暂未生效。",
        "default": false
      },
      "keywords": {
        "type": "object",
        "description": "关键词表（可自定义）",
        "hint": "英文词不区分大小写；修改后需重启插件生效。",
        "items": {
          "gratitude": {
            "type": "list",
            "description": "感谢词表",
            "default": ["谢谢", "感谢", "多谢", "辛苦你", "有你真好", "爱你", "thanks", "thx", "3q"]
          },
          "misunderstood": {
            "type": "list",
            "description": "误解/不满词表",
            "default": ["你误会", "不是这个意思", "你怎么这样", "别烦我", "生气", "失望", "讨厌", "不许", "别说了"]
          },
          "sudden_warmth": {
            "type": "list",
            "description": "关心/温柔词表",
            "default": ["注意身体", "早点休息", "想你了", "抱抱", "在吗", "还好吗", "担心你", "多穿点"]
          },
          "cold_shoulder": {
            "type": "list",
            "description": "敷衍词表",
            "hint": "连续 3 条不超过 2 个字且命中该词表时，判定为敷衍。",
            "default": ["嗯", "哦", "好", "呃", "?", "？"]
          }
        }
      }
    }
  },
  "expression": {
    "type": "object",
    "description": "情绪表达档位",
    "hint": "根据当前情绪挑选表达档位；人物的语气风格由上层插件叠加。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用表达决策",
        "hint": "关闭后始终使用兜底档位。",
        "default": true
      },
      "default_mode": {
        "type": "string",
        "description": "兜底档位",
        "default": "放松"
      },
      "group_allowed_modes": {
        "type": "list",
        "description": "群聊允许档位",
        "hint": "群聊不会出现亲密档位，且温暖程度受下方上限限制。",
        "default": ["放松", "活泼", "温暖"]
      },
      "group_warmth_cap": {
        "type": "float",
        "description": "群聊温暖程度上限",
        "default": 0.55
      }
    }
  },
  "open_thread": {
    "type": "object",
    "description": "未完话题续接",
    "hint": "记录对话里没说完的事，合适的时候自然提起一次。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用未完话题续接",
        "hint": "关闭后不再记录和提起未完话题。",
        "default": true
      },
      "max": {
        "type": "int",
        "description": "每人最多保留条数",
        "hint": "超过上限时自动淘汰最旧的事项；默认 20 条。",
        "default": 20
      },
      "ttl_days": {
        "type": "int",
        "description": "转为搁置的天数",
        "hint": "超过该天数未被提起的事项不再延续；默认 3 天。",
        "default": 3
      },
      "expire_days": {
        "type": "int",
        "description": "自动关闭的天数",
        "hint": "超过该天数未被提起的事项自动关闭；默认 14 天。",
        "default": 14
      },
      "llm_judge_enabled": {
        "type": "bool",
        "description": "启用 LLM 复核",
        "hint": "当前版本仅按规则提取，此开关暂未生效。",
        "default": false
      },
      "followup_max": {
        "type": "int",
        "description": "单条最多提起次数",
        "hint": "同一件事最多主动提起几次；默认 2 次。",
        "default": 2
      }
    }
  },
  "memory_bridge": {
    "type": "object",
    "description": "记忆桥接",
    "hint": "只读使用关联记忆插件提供的用户画像与回忆，让主动消息更贴合对方；未安装时自动忽略。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用记忆桥接",
        "hint": "需要安装记忆插件；未安装时自动忽略，不影响其它功能。",
        "default": true
      },
      "plugin_name": {
        "type": "string",
        "description": "记忆插件名称",
        "hint": "默认即可，除非你使用了改名的记忆插件。",
        "default": "astrbot_plugin_tmemory"
      },
      "timeout_sec": {
        "type": "float",
        "description": "读取等待上限（秒）",
        "hint": "超过该时间自动跳过记忆读取。",
        "default": 2.0
      },
      "limit": {
        "type": "int",
        "description": "每次读取条数",
        "hint": "默认 4 条。",
        "default": 4
      },
      "ttl_min": {
        "type": "int",
        "description": "缓存时间（分钟）",
        "hint": "该时间内不重复读取记忆。",
        "default": 5
      }
    }
  },
  "identity": {
    "type": "object",
    "description": "身份合并",
    "hint": "把同一联系人换过账号产生的旧记录并到一起。",
    "items": {
      "auto_migrate": {
        "type": "bool",
        "description": "自动合并旧记录",
        "hint": "开启后，发现同一联系人的旧记录会自动合并；默认关闭，只提示不合并。",
        "default": false
      }
    }
  },
  "life_line": {
    "type": "object",
    "description": "生活线",
    "hint": "让主动消息带上天气、用餐、作息与昨日小结，并在休息时段不打扰。",
    "items": {
      "life_line_enabled": {
        "type": "bool",
        "description": "启用生活线",
        "hint": "关闭后不生成天气、用餐、作息与日记信息，行为与旧版本一致。",
        "default": true
      },
      "life_city": {
        "type": "string",
        "description": "所在城市",
        "hint": "填写后用于查询当地天气；留空则不使用天气。",
        "default": ""
      },
      "meal_reminders_enabled": {
        "type": "bool",
        "description": "用餐关心",
        "hint": "在早/午/晚时段到点时关心对方有没有吃饭。",
        "default": true
      },
      "sleep_window_auto": {
        "type": "bool",
        "description": "自动推断作息",
        "hint": "根据近期聊天时间推断入睡与起床；关闭后只用下面的安静时段。",
        "default": true
      },
      "quiet_hours": {
        "type": "string",
        "description": "安静时段",
        "hint": "该时段内不主动打扰；格式 时:分-时:分，默认 23:00-07:30。",
        "default": "23:00-07:30"
      },
      "proactive_opt_in": {
        "type": "bool",
        "description": "安静时段也允许主动",
        "hint": "开启后安静时段仍会主动发消息。",
        "default": false
      },
      "breakfast_window": {
        "type": "string",
        "description": "早餐时段",
        "hint": "格式 时:分-时:分，默认 07:00-09:00。",
        "default": "07:00-09:00"
      },
      "lunch_window": {
        "type": "string",
        "description": "午餐时段",
        "hint": "格式 时:分-时:分，默认 11:30-13:00。",
        "default": "11:30-13:00"
      },
      "dinner_window": {
        "type": "string",
        "description": "晚餐时段",
        "hint": "格式 时:分-时:分，默认 18:00-20:00。",
        "default": "18:00-20:00"
      },
      "weather_api_base": {
        "type": "string",
        "description": "天气接口地址（高级）",
        "hint": "一般留空使用内置数据源；仅自建或测试时填写。",
        "default": ""
      },
      "weather_timeout_sec": {
        "type": "float",
        "description": "天气查询超时（秒）",
        "hint": "默认 3 秒，超时自动跳过。",
        "default": 3.0
      },
      "weather_ttl_min": {
        "type": "int",
        "description": "天气缓存时间（分钟）",
        "hint": "默认 45 分钟，期间不重复查询。",
        "default": 45
      }
    }
  },
  "group": {
    "type": "object",
    "description": "群聊",
    "hint": "让机器人在群里懂得分寸：了解群氛围，并按频率限制决定是否接话。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用群聊理解",
        "hint": "关闭后不记录群活动，也不提供群内参与建议。",
        "default": true
      },
      "participation_enabled": {
        "type": "bool",
        "description": "启用群内参与建议",
        "hint": "关闭后仍了解群氛围，但不再建议是否接话。",
        "default": true
      },
      "min_reply_gap_sec": {
        "type": "int",
        "description": "群内最短接话间隔（秒）",
        "hint": "两次接话至少间隔这么久，默认 90 秒。",
        "default": 90
      },
      "hourly_limit": {
        "type": "int",
        "description": "每小时最多接话次数",
        "hint": "每个群每小时最多主动接话几次，默认 6 次。",
        "default": 6
      },
      "busy_group_threshold": {
        "type": "int",
        "description": "群繁忙判定（条/小时）",
        "hint": "群里每小时消息超过该值时暂不接话，默认 120 条。",
        "default": 120
      },
      "member_tracking_enabled": {
        "type": "bool",
        "description": "记录群成员熟悉度",
        "hint": "关闭后不记录成员维度，仅保留群整体活跃度。",
        "default": true
      }
    }
  },
  "growth": {
    "type": "object",
    "description": "成长",
    "hint": "随相处时间与互动，表达逐渐更亲近；有上限，可清零。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用成长",
        "hint": "关闭后不再体现成长变化，行为回到未开启时的状态。",
        "default": true
      },
      "max_level": {
        "type": "int",
        "description": "成长等级上限",
        "hint": "可达到的最高等级，默认 10。",
        "default": 10
      },
      "drift_cap": {
        "type": "float",
        "description": "表达暖度提升上限",
        "hint": "成长最多让表达暖度提高多少，范围 0~0.05，默认 0.05。",
        "default": 0.05
      },
      "reset": {
        "type": "bool",
        "description": "清零成长",
        "hint": "开启后清除已积累的成长，回到初始状态。",
        "default": false
      }
    }
  },
  "content": {
    "type": "object",
    "description": "见闻",
    "hint": "给角色补充一些她自己的见闻或话题，主动消息可以引用；默认关闭。",
    "items": {
      "content_enabled": {
        "type": "bool",
        "description": "启用见闻",
        "hint": "开启后才会读取下面的来源。",
        "default": false
      },
      "content_sources": {
        "type": "list",
        "description": "来源地址",
        "hint": "RSS/Atom 订阅地址，每行一个；仅支持 http/https。",
        "default": []
      },
      "content_topics": {
        "type": "list",
        "description": "兴趣话题",
        "hint": "手动填写的兴趣或话题，每行一个。",
        "default": []
      },
      "content_max_items_per_day": {
        "type": "int",
        "description": "每天最多条数",
        "hint": "范围 1~3，默认 2。",
        "default": 2
      },
      "content_summarize": {
        "type": "bool",
        "description": "用模型整理成一句话",
        "hint": "开启后调用模型把来源概括为一句话；失败时自动改用摘要。",
        "default": false
      },
      "content_provider_id": {
        "type": "string",
        "description": "整理用模型",
        "hint": "留空使用当前会话模型。",
        "default": ""
      },
      "content_max_chars": {
        "type": "int",
        "description": "每条最大字数",
        "hint": "默认 80 字。",
        "default": 80
      },
      "content_ttl_days": {
        "type": "int",
        "description": "保留天数",
        "hint": "过期自动清理，默认 14 天。",
        "default": 14
      }
    }
  }
}
