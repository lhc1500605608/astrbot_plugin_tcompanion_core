{
  "emotion": {
    "type": "object",
    "description": "情绪事件账本",
    "hint": "记录感谢、误解等情绪事件并据此调整好感度；阈值与词表可在此调整。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用情绪事件账本",
        "hint": "关闭后不再记录情绪事件，好感度也不会因对话变化。",
        "default": true
      },
      "reply_window_hours": {
        "type": "int",
        "description": "主动消息回复窗口（小时）",
        "hint": "主动消息发出后，该时间内收到回复则好感度 +0.03。",
        "default": 6
      },
      "ignore_window_hours": {
        "type": "int",
        "description": "主动消息忽略窗口（小时）",
        "hint": "主动消息发出后，该时间内没有收到回复则好感度 -0.02。",
        "default": 6
      },
      "daily_positive_cap": {
        "type": "float",
        "description": "每日好感正向上限",
        "hint": "每天因正向情绪事件最多增加的好感度。",
        "default": 0.1
      },
      "daily_negative_cap": {
        "type": "float",
        "description": "每日好感负向上限",
        "hint": "每天因负向情绪事件最多扣减的好感度；好感度最低为 0。",
        "default": 0.06
      },
      "llm_judge_enabled": {
        "type": "bool",
        "description": "启用 LLM 情绪判定",
        "hint": "当前版本仅按词表判定，此开关暂未生效。",
        "default": false
      },
      "keywords": {
        "type": "object",
        "description": "关键词表（可自定义）",
        "hint": "英文词不区分大小写；修改后需重启插件生效。",
        "items": {
          "gratitude": {
            "type": "list",
            "description": "感谢词表",
            "default": ["谢谢", "感谢", "多谢", "辛苦你", "有你真好", "爱你", "thanks", "thx", "3q"]
          },
          "misunderstood": {
            "type": "list",
            "description": "误解/不满词表",
            "default": ["你误会", "不是这个意思", "你怎么这样", "别烦我", "生气", "失望", "讨厌", "不许", "别说了"]
          },
          "sudden_warmth": {
            "type": "list",
            "description": "关心/温柔词表",
            "default": ["注意身体", "早点休息", "想你了", "抱抱", "在吗", "还好吗", "担心你", "多穿点"]
          },
          "cold_shoulder": {
            "type": "list",
            "description": "敷衍词表",
            "hint": "连续 3 条不超过 2 个字且命中该词表时，判定为敷衍。",
            "default": ["嗯", "哦", "好", "呃", "?", "？"]
          }
        }
      }
    }
  },
  "expression": {
    "type": "object",
    "description": "情绪表达档位",
    "hint": "根据当前情绪挑选表达档位；人物的语气风格由上层插件叠加。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用表达决策",
        "hint": "关闭后始终使用兜底档位。",
        "default": true
      },
      "default_mode": {
        "type": "string",
        "description": "兜底档位",
        "default": "放松"
      },
      "group_allowed_modes": {
        "type": "list",
        "description": "群聊允许档位",
        "hint": "群聊不会出现亲密档位，且温暖程度受下方上限限制。",
        "default": ["放松", "活泼", "温暖"]
      },
      "group_warmth_cap": {
        "type": "float",
        "description": "群聊温暖程度上限",
        "default": 0.55
      }
    }
  },
  "open_thread": {
    "type": "object",
    "description": "未完话题续接",
    "hint": "记录对话里没说完的事，合适的时候自然提起一次。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用未完话题续接",
        "hint": "关闭后不再记录和提起未完话题。",
        "default": true
      },
      "max": {
        "type": "int",
        "description": "每人最多保留条数",
        "hint": "超过上限时自动淘汰最旧的事项；默认 20 条。",
        "default": 20
      },
      "ttl_days": {
        "type": "int",
        "description": "转为搁置的天数",
        "hint": "超过该天数未被提起的事项不再延续；默认 3 天。",
        "default": 3
      },
      "expire_days": {
        "type": "int",
        "description": "自动关闭的天数",
        "hint": "超过该天数未被提起的事项自动关闭；默认 14 天。",
        "default": 14
      },
      "llm_judge_enabled": {
        "type": "bool",
        "description": "启用 LLM 复核",
        "hint": "当前版本仅按规则提取，此开关暂未生效。",
        "default": false
      },
      "followup_max": {
        "type": "int",
        "description": "单条最多提起次数",
        "hint": "同一件事最多主动提起几次；默认 2 次。",
        "default": 2
      }
    }
  }
}
